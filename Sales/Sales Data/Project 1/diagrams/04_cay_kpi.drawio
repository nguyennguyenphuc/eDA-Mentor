<mxfile host="drawio" agent="EDA Mentor build_diagrams.py"><diagram name="04_cay_kpi" id="04_cay_kpi"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Cây KPI Project 1: từ Gross Sales đến chênh lệch với Kế toán" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#447A2A;fontSize=20;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;DISTINCTCOUNT(order_number)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="220" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Units&lt;/b&gt;&lt;br&gt;Σ quantity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="220" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;AOV&lt;/b&gt; = Net Sales / Orders" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6EFF8;strokeColor=#185FA5;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="260" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ASP&lt;/b&gt; = Net Sales / Units" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6EFF8;strokeColor=#185FA5;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=cente
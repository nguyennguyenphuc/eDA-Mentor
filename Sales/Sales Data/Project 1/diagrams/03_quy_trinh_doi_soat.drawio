<mxfile host="drawio" agent="EDA Mentor build_diagrams.py"><diagram name="03_quy_trinh_doi_soat" id="03_quy_trinh_doi_soat"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Quy trình đối soát doanh thu: dữ liệu đơn ↔ Finance (tháng × cửa hàng × kênh)" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#447A2A;fontSize=20;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;fact_sales_line&lt;/b&gt;&lt;br&gt;63.004 dòng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECF2EA;strokeColor=#447A2A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="c5" value="① Bỏ dòng trùng&lt;br&gt;(order_number + line_item)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#447A2A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="60" as="geometry"/></mxCell><mxCell id="c6" value="② Giữ đơn COMPLETED&lt;br&gt;(loại CANCELLED, PENDING)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#447A2A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="220" height="60" as="geometry"/></mxCell><mxCell id="c7" value="③ Gross Sales − Discounts&lt;br&gt;= &lt;b&gt;Net Sales&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#447A2A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="220" height="70" as="geometry"/></mxCell><mxCell id="c8" value="④ Net Sales − Returns&lt;br&gt;= &lt;b&gt;Net Revenue&lt;/b&gt; (đơn)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECF2EA;strokeColor=#447A2A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="220" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;finance_revenue.xlsx&lt;/b&gt;&lt;br&gt;ngày × fin_store_code" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7EAE5;strokeColor=#993C1D;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="c10" value="⑤ Map fin_store_code → store_key&lt;br&gt;theo valid_from / valid_to&lt;br&gt;tách riêng HQ-ADJ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="220" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Σ net_revenue&lt;br&gt;= &lt;b&gt;Net Revenue (Finance)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7EAE5;strokeColor=#993C1D;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="220" height="60" as="geometry"/></mxCell><mxCell id="c12" value="⑥ Ghép theo tháng × store_key&lt;br&gt;Δ = Finance − Đơn hàng; Δ % = Δ / |Finance|" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Vượt ngưỡng?&lt;br&gt;|Δ| &amp;gt; 200 USD&lt;br&gt;và |Δ%| &amp;gt; 1 %" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#5F5E5A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="490" width="200" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Trong ngưỡng&lt;br&gt;ghi nhận, không cần giải thích" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECF2EA;strokeColor=#447A2A;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="510" width="200" height="60" as="geometry"/></mxCell><mxCell id="c15" value="⑦ Phân rã nguyên nhân&lt;br&gt;xem theo &lt;b&gt;ngày&lt;/b&gt; và theo &lt;b&gt;kênh&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7EAE5;strokeColor=#993C1D;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="500" width="260" height="80" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=3;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=13;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="610" width="600" height="390" as="geometry"/></mxCell><mxCell id="c17" value="Nguyên nhân cần dò (kiểm từng cái, ghi số tiền)" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#993C1D;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="612" width="400" height="26" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Online lệch thời điểm&lt;/b&gt; · đơn tính ngày đặt, Finance tính ngày giao → quy đổi bằng delivery_date" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="642" width="580" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Hoàn tiền hạch toán trễ&lt;/b&gt; · Δ dương/âm thành cặp ở 2 ngày/tháng liền kề" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="692" width="580" height="44" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Đơn huỷ vẫn ghi nhận&lt;/b&gt; · Finance &amp;gt; đơn đúng bằng giá trị đơn CANCELLED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="742" width="580" height="44" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Thiếu dữ liệu ngày&lt;/b&gt; · Finance = 0 ở ngày cửa hàng có bán" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="792" width="580" height="44" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Ghi trùng bút toán&lt;/b&gt; · 2 dòng Finance giống hệt nhau" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#993C1D;fontColor=#262626;fontSize=12;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="842" width="580" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Doanh thu gồm VAT&lt;/b&gt; · Finance cao hơn ≈ 10 % cả tháng" style="rounded=1;ar